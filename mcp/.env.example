# --- Deployment: docker compose only (not read by the server) ---
# Compose interpolates this into the Traefik router label: pwgen-mcp.<MCP_DOMAIN>
MCP_DOMAIN=example.net

# --- Who can connect (claude.ai signs in through Dex) ---
# Public URL of the MCP endpoint, as claude.ai reaches it
MCP_RESOURCE_URL=https://pwgen-mcp.example.net/mcp
# Comma-separated Dex emails allowed to use the server
MCP_ALLOWED_EMAILS=roland@example.net
# MCP_OIDC_ISSUER=https://auth.example.net     # default
# MCP_OIDC_AUDIENCE=pwgen-mcp                   # default: the Dex client claude.ai uses

# --- OpenBao: the server's own AppRole login (pwgen-mcp policy) ---
# role_id:   bao read -field=role_id auth/approle/role/pwgen-mcp-server/role-id
# secret_id: bao write -f -field=secret_id auth/approle/role/pwgen-mcp-server/secret-id
BAO_ROLE_ID=
BAO_SECRET_ID=
# BAO_ADDR=https://openbao.example.net         # default
# BAO_MOUNT=kv                                  # default
# BAO_BASE_PATH=pwgen                           # default

# --- Optional ---
# MCP_PORT=8080
# MCP_HOST=0.0.0.0
