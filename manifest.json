{
  "manifest_version": 3,
  "name": "pwgen-browser",
  "version": "2.1.0",
  "key": "",
  "icons": {
    "48": "images/icon48.png",
    "128": "images/icon128.png",
    "16": "images/icon16.png"
  },
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": ["https://openbao.example.net/*"],
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
