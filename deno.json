{
  "version": "2.0.1",
  "tasks": {
    "build": "NODE_ENV=production deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "check": "deno task build && deno check src/",
    "lint": "deno lint",
    "release": "deno run --allow-read --allow-write --allow-env --allow-run scripts/release.ts"
  },
  "imports": {
    "@/": "./src/",
    "@components/": "./src/components/",
    "@types": "./src/types/index.ts",
    "@rolandwarburton/pwgen": "npm:@rolandwarburton/pwgen@^1.1.1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@types/chrome": "npm:@types/chrome@^0.0.254",
    "@types/react": "npm:@types/react@^19.3.0",
    "goober": "npm:goober@^2.1.19",
    "qrcode.react": "npm:qrcode.react@^4.2.0",
    "react": "npm:react@^19.3.0",
    "react-dom": "npm:react-dom@^19.3.0",
    "react-router": "npm:react-router@^8.4.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["@types/chrome"],
    "strict": true
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": true,
    "trailingCommas": "never",
    "lineWidth": 120
  },
  "lint": {
    "include": ["src/", "scripts/"],
    "rules": {
      "tags": ["recommended", "react", "jsx"]
    }
  },
  "nodeModulesDir": "none",
  "exclude": ["mcp/", "dist/", "node_modules/"]
}
